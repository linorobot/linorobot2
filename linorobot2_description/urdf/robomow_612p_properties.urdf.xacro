<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Robomow 612P Dimensions (converted from inches to meters) -->
  <!-- 1 inch = 0.0254 meters -->
  
  <!-- Horizontal distance between centers of wheels: 22 inch = 0.5588 m -->
  <xacro:property name="base_width" value="0.5588" />
  
  <!-- Driving wheel diameter: 8.5 inch -> radius: 4.25 inch = 0.10795 m -->
  <xacro:property name="wheel_radius" value="0.10795" />
  <xacro:property name="wheel_width" value="0.090" />
  
  <!-- Caster wheel position: 19 inch from driving axle = 0.4826 m -->
  <xacro:property name="wheel_pos_x" value="0.0" />
  <xacro:property name="wheel_pos_y" value="0.2794" /> <!-- base_width / 2 -->
  <xacro:property name="wheel_pos_z" value="0.0" />
  
  <!-- Caster wheel diameter: 3.5 inch -> radius: 1.75 inch = 0.04445 m -->
  <xacro:property name="caster_radius" value="0.04445" />
  <xacro:property name="caster_pos_x" value="0.4826" />
  <xacro:property name="caster_pos_y" value="0.0" />
  <xacro:property name="caster_pos_z" value="0.0" />

  <!-- Base dimensions -->
  <xacro:property name="base_length" value="0.71" />
  <xacro:property name="base_height" value="0.15" />
  <xacro:property name="base_mass" value="20.0" />
  <xacro:property name="base_mesh_file" value="" />

  <xacro:property name="wheel_mass" value="1.0" />
  <xacro:property name="wheel_torque" value="20" />
  
  <xacro:property name="front_caster_wheel" value="true" />
  <xacro:property name="rear_caster_wheel" value="false" />
  
  <xacro:property name="wheel_mesh_file" value="" />
  
  <xacro:property name="laser_pose">
    <origin xyz="0.3 0 0.2" rpy="0 0 0"/>
  </xacro:property>
  
  <xacro:property name="depth_sensor_pose">
    <origin xyz="0.3 0 0.1" rpy="0 0 0"/>
  </xacro:property>
</robot>
